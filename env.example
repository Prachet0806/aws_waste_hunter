# Local configuration example. Do not commit secrets. No automatic dotenv loading.
SCAN_REGION=us-east-1
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:reports
REPORT_BUCKET=replace-with-stack-output
REPORT_PREFIX=reports
# RUN_TABLE and STATE_MACHINE_ARN are injected by SAM for production handlers.
PRICING_MODE=static
CPU_THRESHOLD=2
NETWORK_THRESHOLD=1000000
RDS_CPU_THRESHOLD=5
RDS_CONNECTIONS_THRESHOLD=1
MIN_SNAPSHOT_AGE_DAYS=7
MIN_METRIC_COVERAGE=0.9
MIN_OBSERVATION_DAYS=7
WASTE_ALERT_THRESHOLD=1000
MAX_SCANNER_WORKERS=4
SCAN_TIMEOUT_SECONDS=240
PRICING_TIMEOUT_SECONDS=60
MAX_INVENTORY_RESOURCES=100000
# Total scanner-artifact read budget for finalization (1 KiB to 2 MiB).
MAX_FINALIZER_INPUT_BYTES=2097152
REQUIRED_TAGS=owner,env,cost-center
EXCLUDED_TAGS_JSON='{"waste-hunter:exclude":"true","waste-hunter-backup":"true"}'
S3_SSE=AES256
# S3_KMS_KEY_ID=<key-arn> with S3_SSE=aws:kms
LOG_LEVEL=INFO
REPORT_SCHEDULE=Weekly
# SNS_TOPIC_REGION must match the topic's region.
# PRICING_JSON or PRICING_FILE can supply validated per-component rates.
