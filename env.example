# Copy to .env and fill in real values. Never commit .env.
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:sre-cost-alerts
# Optional: override SNS region (defaults to region parsed from SNS_TOPIC_ARN, then AWS_REGION)
# SNS_TOPIC_REGION=us-east-1
# Must be a bucket NAME (not ARN). Prefix/encryption configurable below.
REPORT_BUCKET=sre-finops-reports
REPORT_PREFIX=reports
# S3_SSE=AES256 (default) or aws:kms with S3_KMS_KEY_ID
# S3_SSE=AES256
# S3_KMS_KEY_ID=
# S3_STORAGE_CLASS=
# Pricing: static (default, deterministic) or live (Pricing API primary, static fallback)
PRICING_MODE=static
# Optional pricing overrides (JSON string takes precedence over file)
# PRICING_JSON={"EBS": 0.10}
# PRICING_FILE=./pricing.json
AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1
# Log level: DEBUG, INFO (default), WARNING, ERROR
# LOG_LEVEL=INFO
# Report schedule label used in SNS subject (Weekly/Daily)
# REPORT_SCHEDULE=Weekly
CPU_THRESHOLD=2
NETWORK_THRESHOLD=1000000
RDS_CPU_THRESHOLD=5
RDS_CONNECTIONS_THRESHOLD=1
MIN_SNAPSHOT_AGE_DAYS=7
WASTE_ALERT_THRESHOLD=1000
# Tag compliance (comma-separated; empty falls back to defaults with a warning)
REQUIRED_TAGS=owner,env,cost-center
MAX_SCANNER_WORKERS=4
